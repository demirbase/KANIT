Bootstrap: docker
# The final containers (F6.2) pin the base image by digest; the development ones use the tag.
From: condaforge/miniforge3:latest
# ============================================================================
# amr-tools.sif — the external tools of KANIT v1.0 (environment-tools.yml)
# ============================================================================
# QUAST, pyseer, AMRFinderPlus, ResFinder and KMA, run as shell commands by the
# workflow. Python 3.12 (was 3.8). Build like amr.def, then export the lock file:
#   apptainer build --fakeroot $AMR_WORK/containers/amr-tools.sif amr-tools.def
#   apptainer exec $AMR_WORK/containers/amr-tools.sif conda env export \
#       -p /opt/amr-tools-env > environment-tools.lock.yml
# AMRFinderPlus's database is not in the image: it is downloaded with the other
# databases (F6.2) and recorded with scripts/databases.py.
# ============================================================================

%files
    environment-tools.yml /opt/environment-tools.yml

%post
    mamba env create -f /opt/environment-tools.yml -p /opt/amr-tools-env
    mamba clean -a -y

%environment
    export PATH=/opt/amr-tools-env/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec "$@"

%test
    export PATH=/opt/amr-tools-env/bin:$PATH
    quast.py --version
    pyseer --version
    amrfinder --version
    python -m resfinder --version || run_resfinder.py --version
    kma -v
    blastn -version
