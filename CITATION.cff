    given-names: "Eren"
    email: "eren0demirbas@gmail.com"
repository-code: "https://github.com/demirbase/ML_AMR_Prediction_v2"
license: MIT
version: "1.0.0"
keywords:
  - antimicrobial resistance
  - machine learning
  - unitig
  - XGBoost
  - stability selection
  - lineage-aware validation
  - pyseer
  - knowledge base
  - evidence grading
  - ESKAPEE
  - CARD
  - FAIR
