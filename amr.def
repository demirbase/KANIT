Bootstrap: docker
# The final containers (F6.2) pin the base image by digest; the development ones use the tag.
From: condaforge/miniforge3:latest
# ============================================================================
# amr.sif — the analysis container of KANIT v1.0 (environment.yml)
# ============================================================================
# Every KANIT step in Python and the tools they call: unitig-caller, PopPUNK
# (graph-tool) and RGI (DIAMOND, BLAST+). pyseer, QUAST, AMRFinderPlus and ResFinder
# are in amr-tools.sif, CheckM2 in amr-checkm2.sif (their dependency trees conflict).
#
# Build on a debug node (internet and fakeroot; the build cannot bind /arf):
#   srun -p debug -N1 -c8 --time=02:00:00 --pty bash
#   unset APPTAINER_BINDPATH
#   export APPTAINER_TMPDIR=/tmp/apptmp APPTAINER_CACHEDIR=/tmp/apcache
#   mkdir -p "$APPTAINER_TMPDIR" "$APPTAINER_CACHEDIR"
#   apptainer build --fakeroot $AMR_WORK/containers/amr.sif amr.def
# Then export the lock file from the new container and commit it:
#   apptainer exec $AMR_WORK/containers/amr.sif conda env export -p /opt/amr-env \
#       > environment.lock.yml
# The %test section runs at the end of the build; a missing tool stops it.
# ============================================================================

%files
    environment.yml /opt/environment.yml

%post
    mamba env create -f /opt/environment.yml -p /opt/amr-env
    mamba clean -a -y

%environment
    export PATH=/opt/amr-env/bin:$PATH
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%test
    export PATH=/opt/amr-env/bin:$PATH
    python -c "import pandas, numpy, scipy, sklearn, xgboost, optuna, yaml, matplotlib, Bio"
    unitig-caller --version
    poppunk --version
    python -c "import graph_tool; print(graph_tool.__version__)"
    rgi main --version
    diamond version
    blastn -version

%runscript
    exec python "$@"
