// TRUBA (ARF): SLURM executor, Apptainer containers and the resources of every
// label (-profile truba). The rules of the cluster:
//   * jobs are submitted from /arf/scratch (the work directory is there);
//   * every job runs on one node (--nodes=1); nodes that fail or slow jobs are
//     excluded (--exclude_nodes; 2026-10: barbun45 and barbun46 fail Apptainer,
//     barbun118 aborted PopPUNK, barbun89 ran the pilot's units 2-4 times slower);
//   * job and file names may not contain spaces, brackets, quotes, ',', '=', '$',
//     Turkish letters and similar characters;
//   * barbun: 40 cores and 384 GB per node, at least 20 cores per job, at most
//     9.5 GB per core, at most 3 days; hamsi: 56 cores, about 3.3 GB per core;
//     orfoz: 112 cores, 2.17 GB per core; debug: 4 hours, 2.17 GB per core;
//   * at most 100 submitted jobs per user (queueSize 90 leaves room);
//   * compute nodes have no internet: the DOWNLOAD and CONTEXT entries run their
//     tasks on the login node (label internet, local executor).
// The head job runs on the login node (every partition allows at most 3 days), whose
// processes may use 300 s of CPU (360 s hard; 2026-10-08): a lean JVM, the soft limit
// raised to the hard one and its CPU time watched. Near the limit it is stopped with
// SIGKILL (its jobs keep running), the pending jobs are cancelled and, once the running
// ones have ended, it is launched again with -resume; --reuse_units keeps what they finished:
//   ulimit -St 360; export NXF_OPTS='-Xms1g -Xmx4g -XX:+UseSerialGC -XX:-UsePerfData'
//   setsid nohup nextflow run main.nf -profile truba --organisms ecoli,kpneumoniae \
//       --reuse_units -ansi-log false [-resume] > run.out 2>&1 < /dev/null &

params {
    queue          = 'barbun'
    queue_light    = null       // partition of the short steps (label light); null: queue
    queue_large    = null       // partition of the heavy steps of large_organisms; null: queue
    large_organisms = ''        // e.g. ecoli,kpneumoniae (see heavyQueue)
    exclude_nodes  = 'barbun45,barbun46,barbun118,barbun89'   // see the rules above
    containers_dir = "/arf/scratch/${System.getenv('USER')}/amr/containers"
    container_amr     = "${params.containers_dir}/amr.sif"           // analysis (and RGI, F6.1)
    container_tools   = "${params.containers_dir}/amr-tools.sif"     // QUAST, AMRFinderPlus, ResFinder
    container_pyseer  = "${params.containers_dir}/amr-pyseer.sif"    // pyseer (Python 3.8)
    container_checkm2 = "${params.containers_dir}/amr-checkm2.sif"
    // the reference databases, downloaded on one day and recorded with scripts/databases.py
    databases_dir     = "${projectDir}/data/external"
    amrfinder_db      = "${params.databases_dir}/amrfinderplus/latest"
    resfinder_db      = "${params.databases_dir}/resfinder_db"
    pointfinder_db    = "${params.databases_dir}/pointfinder_db"
    checkm2_db        = "${params.databases_dir}/checkm2/CheckM2_database/uniref100.KO.1.dmnd"
    // cores and memory per core (MaxMemPerCPU, MiB) of every partition, the fewest
    // cores a job may ask for, the longest time, and the multiple the cores must be
    // (TRUBA, 2026-10: hamsi jobs take whole 56-core nodes, orfoz jobs 56 or 112 cores)
    partitions = [
        barbun: [cpus: 40, min_cpus: 20, mb_per_cpu: 9500, max_hours: 72, step: 1],
        hamsi : [cpus: 56, min_cpus: 56, mb_per_cpu: 3300, max_hours: 72, step: 56],
        orfoz : [cpus: 112, min_cpus: 56, mb_per_cpu: 2170, max_hours: 72, step: 56],
        debug : [cpus: 40, min_cpus: 1, mb_per_cpu: 2170, max_hours: 4, step: 1],
    ]
}

workDir = "/arf/scratch/${System.getenv('USER')}/amr/nf-work"

executor {
    name              = 'slurm'
    // TRUBA rejects job names with spaces, brackets, ':' and similar characters
    jobName           = { "kanit_${task.process.tokenize(':')[-1]}_" +
                          "${(task.tag ?: task.index).toString().replaceAll(/[^A-Za-z0-9_.-]+/, '_')}".take(80) }
    queueSize         = 90
    submitRateLimit   = '10/1min'
    pollInterval      = '1 min'
    queueStatInterval = '5 min'
}

apptainer {
    enabled    = true
    autoMounts = true
    runOptions = '--no-home -B /arf'
}

env {
    APPTAINER_BINDPATH        = '/arf'
    AMRFINDER_DB              = params.amrfinder_db
    CGE_RESFINDER_RESGENE_DB  = params.resfinder_db
    CGE_RESFINDER_RESPOINT_DB = params.pointfinder_db
    CHECKM2DB                 = params.checkm2_db
    // Python writes its output as it goes, so that the logs of a running job show its
    // progress (the units of a packed job wrote nothing until they ended)
    PYTHONUNBUFFERED          = '1'
}

// memory of one attempt in MiB: the label's GiB, doubled on every retry after an
// out-of-memory or killed job, never above what one node of the partition gives
def memoryFor(gib, attempt, queue = params.queue) {
    def p = params.partitions[queue]
    def cap = Math.floor(p.cpus * p.mb_per_cpu * 0.95) as long
    Math.min((gib * 1024 * Math.pow(2, attempt - 1)) as long, cap)
}

// time limit: the label's hours, never above the partition's limit
def timeFor(hours, queue = params.queue) {
    Math.min(hours, params.partitions[queue].max_hours)
}

// the partition of the short steps: --queue_light (e.g. debug, whose jobs start sooner),
// else --queue
def lightQueue() {
    params.queue_light ?: params.queue
}

// the partition of a heavy step (store, matrix, outer folds, permutations, CPSS, MDA) of one
// organism: --queue_large for the organisms of --large_organisms, else --queue. Two outer
// folds of E. coli or K. pneumoniae fill a job's 180 GiB, which barbun gives with 20 cores
// and hamsi only with a whole 56-core node.
def heavyQueue(org) {
    params.queue_large && (org in params.large_organisms.toString().tokenize(',')) ?
        params.queue_large : params.queue
}

// cores of one attempt: enough for its memory (MiB) at the partition's MaxMemPerCPU
def cpusFor(mb, wanted, queue = params.queue) {
    def p = params.partitions[queue]
    int n = Math.max(p.min_cpus, Math.max(wanted, Math.ceil(mb / p.mb_per_cpu) as int))
    Math.min(p.cpus, ((n + p.step - 1).intdiv(p.step) * p.step) as int)
}

process {
    executor       = 'slurm'
    queue          = { params.queue }
    clusterOptions = { "--nodes=1" + (params.exclude_nodes ? " --exclude=${params.exclude_nodes}" : '') }
    container      = params.container_amr
    // retried, with the next attempt's resources: 137 (killed, memory), 140 (over the
    // time or memory limit), and a job the system removed without an exit status
    // (Integer.MAX_VALUE; e.g. a node failure: job 6443221 was cancelled by root on
    // hamsi20 one second after it started, 2026-10-04)
    errorStrategy  = { (task.exitStatus in [137, 140] || task.exitStatus == Integer.MAX_VALUE)
                       && task.attempt <= 3 ? 'retry' : 'terminate' }
    maxRetries     = 3

    withLabel: light {
        queue  = { lightQueue() }
        memory = { memoryFor(16, task.attempt, lightQueue()).MB }
        cpus   = { cpusFor(memoryFor(16, task.attempt, lightQueue()), 1, lightQueue()) }
        time   = { timeFor(1 << (task.attempt - 1), lightQueue()).h }
    }
    withLabel: lineage {
        memory = { memoryFor(128, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(128, task.attempt), 40) }
        time   = { timeFor(24).h }
    }
    withLabel: store {
        queue  = { heavyQueue(org) }
        memory = { memoryFor(300, task.attempt, heavyQueue(org)).MB }
        cpus   = { cpusFor(memoryFor(300, task.attempt, heavyQueue(org)), 40, heavyQueue(org)) }
        time   = { timeFor(24, heavyQueue(org)).h }
    }
    withLabel: matrix {
        queue  = { heavyQueue(meta.organism) }
        memory = { memoryFor(64, task.attempt, heavyQueue(meta.organism)).MB }
        cpus   = { cpusFor(memoryFor(64, task.attempt, heavyQueue(meta.organism)), 1,
                           heavyQueue(meta.organism)) }
        time   = { timeFor(6, heavyQueue(meta.organism)).h }
    }
    // time limits: a few times the longest task of the pilot (A. baumannii, 2026-10-07:
    // light steps minutes, CPSS seconds, MDA 2 min, permutation batches 2.9 h, outer folds
    // and final models 8.6 h), doubled on every retry after a time-out; a long limit kept
    // the jobs of a low-priority account out of the gaps the scheduler fills
    // the outer folds or permutation chunks of one model that share a job (lib/packing.py;
    // config.yaml packing.budget_gb); 180 GiB fits barbun's 20 cores (9,500 MB per core)
    // (E. coli, every genome: 76 GiB in the process, 104 GiB by sacct, 2026-10-02)
    withLabel: cv_unit {
        queue  = { heavyQueue(meta.organism) }
        memory = { memoryFor(180, task.attempt, heavyQueue(meta.organism)).MB }
        cpus   = { cpusFor(memoryFor(180, task.attempt, heavyQueue(meta.organism)), 20,
                           heavyQueue(meta.organism)) }
        time   = { timeFor(24 << (task.attempt - 1), heavyQueue(meta.organism)).h }
    }
    withLabel: permutation {
        queue  = { heavyQueue(meta.organism) }
        memory = { memoryFor(180, task.attempt, heavyQueue(meta.organism)).MB }
        cpus   = { cpusFor(memoryFor(180, task.attempt, heavyQueue(meta.organism)), 20,
                           heavyQueue(meta.organism)) }
        time   = { timeFor(6 << (task.attempt - 1), heavyQueue(meta.organism)).h }
    }
    withLabel: cpss {
        queue  = { heavyQueue(meta.organism) }
        memory = { memoryFor(32, task.attempt, heavyQueue(meta.organism)).MB }
        cpus   = { cpusFor(memoryFor(32, task.attempt, heavyQueue(meta.organism)), 20,
                           heavyQueue(meta.organism)) }
        time   = { timeFor(4 << (task.attempt - 1), heavyQueue(meta.organism)).h }
    }
    withLabel: mda {
        queue  = { heavyQueue(meta.organism) }
        memory = { memoryFor(48, task.attempt, heavyQueue(meta.organism)).MB }
        cpus   = { cpusFor(memoryFor(48, task.attempt, heavyQueue(meta.organism)), 1,
                           heavyQueue(meta.organism)) }
        time   = { timeFor(6 << (task.attempt - 1), heavyQueue(meta.organism)).h }
    }
    withLabel: cabbage {             // external validation: poppunk_assign, unitig calls, predictions
        memory = { memoryFor(64, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(64, task.attempt), 20) }
        time   = { timeFor(24).h }
    }
    withLabel: rgi {
        memory = { memoryFor(64, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(64, task.attempt), 20) }
        time   = { timeFor(48).h }
    }
    withLabel: tools {
        container = params.container_tools
        memory    = { memoryFor(64, task.attempt).MB }
        cpus      = { cpusFor(memoryFor(64, task.attempt), 20) }
        time      = { timeFor(48).h }
    }
    withLabel: pyseer {
        container = params.container_pyseer
        memory    = { memoryFor(64, task.attempt).MB }
        cpus      = { cpusFor(memoryFor(64, task.attempt), 20) }
        time      = { timeFor(48).h }
    }
    withLabel: checkm2 {
        container = params.container_checkm2
        memory    = { memoryFor(200, task.attempt).MB }
        cpus      = { cpusFor(memoryFor(200, task.attempt), 40) }
        time      = { timeFor(72).h }
    }
    withLabel: kb {
        memory = { memoryFor(64, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(64, task.attempt), 1) }
        time   = { timeFor(6).h }
    }
    withLabel: outputs {
        // the checksums of the outputs; the first run reads every file
        memory = { memoryFor(16, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(16, task.attempt), 20) }
        time   = { timeFor(12).h }
    }
    withLabel: backup {
        // tar and pigz of the changed units of the results tree
        memory = { memoryFor(16, task.attempt).MB }
        cpus   = { cpusFor(memoryFor(16, task.attempt), 20) }
        time   = { timeFor(24).h }
    }
    withLabel: host {
        // rclone and sacct live on the login node, not in the containers
        executor  = 'local'
        container = ''
        cpus      = 1
        memory    = 4.GB
        time      = 72.h
    }
    withLabel: internet {
        executor = 'local'               // on the login node, whatever the partition
        cpus     = 1
        memory   = 8.GB
        time     = 72.h
    }
}
