{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/iumobg/KANIT/main/nextflow_schema.json",
    "title": "KANIT workflow parameters",
    "description": "How the KANIT workflow runs; every analysis setting lives in config/config.yaml.",
    "type": "object",
    "$defs": {
        "input": {
            "title": "Input",
            "type": "object",
            "required": [
                "organisms"
            ],
            "properties": {
                "organisms": {
                    "type": "string",
                    "pattern": "^[a-z_]+(,[a-z_]+)*$",
                    "description": "Comma-separated organism ids of config/registry/organisms.yaml, e.g. ecoli,kpneumoniae."
                },
                "config_yaml": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "The analysis configuration (read for fan-out sizes; the steps read it themselves)."
                },
                "stub_panel": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "description": "Only with -stub-run: panel decisions to fan the models out from."
                },
                "config_overlay": {
                    "type": "string",
                    "format": "file-path",
                    "description": "YAML merged over config.yaml for every step (for example tests/data/e2e_overlay.yaml)."
                }
            }
        },
        "execution": {
            "title": "Execution",
            "type": "object",
            "properties": {
                "python": {
                    "type": "string",
                    "default": "python",
                    "description": "Python interpreter of the analysis container."
                },
                "rgi_shards": {
                    "type": "integer",
                    "default": 20,
                    "minimum": 1,
                    "description": "RGI tasks per organism."
                },
                "allow_missing_context": {
                    "type": "boolean",
                    "default": false,
                    "description": "KB entry only: build without the NCBI context of an organism (development builds)."
                },
                "trace_dir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "The run directory: run manifest, trace, report, timeline, DAG, every task's receipt, the output checksums and the resource report (one per launch)."
                },
                "external_shards": {
                    "type": "integer",
                    "default": 20,
                    "minimum": 1,
                    "description": "AMRFinderPlus and ResFinder tasks per organism."
                },
                "host_python": {
                    "type": "string",
                    "description": "Python 3.6+ on the login node, for the receipts of the tasks that run there outside the containers."
                }
            }
        },
        "truba": {
            "title": "TRUBA (-profile truba)",
            "type": "object",
            "properties": {
                "queue": {
                    "type": "string",
                    "enum": [
                        "barbun",
                        "hamsi",
                        "orfoz",
                        "debug"
                    ],
                    "description": "SLURM partition of every task."
                },
                "containers_dir": {
                    "type": "string",
                    "description": "Directory of the Apptainer images."
                },
                "container_amr": {
                    "type": "string",
                    "description": "Analysis image."
                },
                "container_tools": {
                    "type": "string",
                    "description": "Image with QUAST, pyseer, AMRFinderPlus and ResFinder."
                },
                "container_checkm2": {
                    "type": "string",
                    "description": "CheckM2 image."
                },
                "partitions": {
                    "type": "object",
                    "hidden": true,
                    "description": "Cores, memory per core, minimum cores and time limit of every partition."
                },
                "databases_dir": {
                    "type": "string",
                    "description": "Directory of the reference databases."
                },
                "amrfinder_db": {
                    "type": "string",
                    "description": "AMRFinderPlus database (amrfinder --database)."
                },
                "resfinder_db": {
                    "type": "string",
                    "description": "ResFinder database (CGE_RESFINDER_RESGENE_DB)."
                },
                "pointfinder_db": {
                    "type": "string",
                    "description": "PointFinder database (CGE_RESFINDER_RESPOINT_DB)."
                },
                "checkm2_db": {
                    "type": "string",
                    "description": "CheckM2 DIAMOND database (CHECKM2DB)."
                }
            }
        },
        "backup": {
            "title": "Verified backup",
            "type": "object",
            "description": "Backup at the end of every stage (scripts/backup.py, scripts/backup_upload.sh).",
            "properties": {
                "backup_remote": {
                    "type": "string",
                    "description": "rclone remote and folder of the backups (e.g. gdrive:KANIT_backup), or 'none' to run without them; required on TRUBA."
                },
                "backup_stage": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Staging directory of the archives until they are verified on the remote."
                },
                "backup_ledger": {
                    "type": "string",
                    "description": "Ledger of the verified backups (one row per unit and backup)."
                },
                "rclone": {
                    "type": "string",
                    "description": "rclone executable on the login node."
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input"
        },
        {
            "$ref": "#/$defs/execution"
        },
        {
            "$ref": "#/$defs/truba"
        },
        {
            "$ref": "#/$defs/backup"
        }
    ]
}
