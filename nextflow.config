// KANIT v1.0 workflow (protocol docs/V1_PROTOKOL.md; config/config.yaml holds every
// analysis setting, this file only how and where the tasks run).

manifest {
    name            = 'KANIT'
    description     = 'Evidence-graded knowledge base of AMR biomarkers (unitigs) in ESKAPEE pathogens'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version         = '1.0.0'
}

plugins {
    id 'nf-schema@2.3.0'
}

params {
    organisms             = null          // comma-separated registry ids (required)
    config_yaml           = "${projectDir}/config/config.yaml"
    python                = 'python'      // interpreter of the analysis container
    rgi_shards            = 20            // RGI tasks per organism
    external_shards       = 20            // AMRFinderPlus and ResFinder tasks per organism
    allow_missing_context = false         // KB entry: build without NCBI context (development)
    stub_panel            = null          // -stub-run: panel decisions to fan out
    // one directory per launch: run manifest, trace, report, timeline, DAG, every task's
    // receipt and the checksums of the outputs at the end of the run
    trace_dir             = "${launchDir}/runs/nextflow/" +
                            new java.text.SimpleDateFormat("yyyyMMdd'T'HHmmss").format(new Date())
}

validation {
    help.enabled = true
}

process {
    shell         = ['/bin/bash', '-euo', 'pipefail']
    cpus          = 1
    memory        = 4.GB
    time          = 4.h
    errorStrategy = 'terminate'
    // every task's receipt (its step manifest) is kept with the run, cached tasks too
    publishDir    = [path: { "${params.trace_dir}/tasks/${task.process.tokenize(':')[-1]}/" +
                             "${(task.tag ?: 'run').toString().replaceAll(/[^A-Za-z0-9_.-]+/, '_')}" },
                     pattern: 'receipt.json', mode: 'copy']
}

timeline { enabled = true; file = "${params.trace_dir}/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.trace_dir}/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.trace_dir}/trace.tsv";     overwrite = true
           fields = 'task_id,hash,native_id,process,tag,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar' }
dag      { enabled = true; file = "${params.trace_dir}/dag.html";      overwrite = true }

profiles {
    // the tasks on this machine, no containers (unit tests, -stub-run)
    test {
        process.executor = 'local'
        executor.cpus    = 4
    }
    // TRUBA: SLURM and Apptainer (F3.2)
    truba {
        includeConfig 'conf/truba.config'
    }
}
